// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`buildFfmpegArgs (pure, snapshot) > mp4 -> gif builds a single-pass palettegen/paletteuse filter 1`] = `
[
  "-i",
  "/in.mp4",
  "-filter_complex",
  "fps=12,scale=480:-1:flags=lanczos,split[a][b];[a]palettegen[p];[b][p]paletteuse",
  "/out.gif",
]
`;

exports[`buildFfmpegArgs (pure, snapshot) > mp4 -> ogv (theora + vorbis) 1`] = `
[
  "-i",
  "/in.mp4",
  "-map_metadata",
  "0",
  "-c:v",
  "libtheora",
  "-q:v",
  "8",
  "-c:a",
  "libvorbis",
  "-q:a",
  "9",
  "/out.ogv",
]
`;

exports[`buildFfmpegArgs (pure, snapshot) > mp4 -> webm (vp9 + opus) 1`] = `
[
  "-i",
  "/in.mp4",
  "-map_metadata",
  "0",
  "-c:v",
  "libvpx-vp9",
  "-crf",
  "23",
  "-b:v",
  "0",
  "-c:a",
  "libopus",
  "-b:a",
  "128k",
  "/out.webm",
]
`;

exports[`buildFfmpegArgs (pure, snapshot) > mp4 -> y4m drops audio and uses no encoder flags 1`] = `
[
  "-i",
  "/in.mp4",
  "-map_metadata",
  "0",
  "-pix_fmt",
  "yuv420p",
  "-an",
  "/out.y4m",
]
`;

exports[`buildFfmpegArgs (pure, snapshot) > remux: mp4 -> mov produces -c copy 1`] = `
[
  "-i",
  "/in.mp4",
  "-map",
  "0:v:0?",
  "-map",
  "0:a:0?",
  "-c",
  "copy",
  "-movflags",
  "+faststart",
  "/out.mov",
]
`;
