{
  "name": "file-warper",
  "version": "1.3.0",
  "private": true,
  "description": "Convert anything into anything. Offline.",
  "author": "Luca Manuel <lucamanuel06@gmail.com>",
  "license": "MIT",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k -n next,esbuild,electron -c blue,yellow,green \"next dev -p 3000\" \"node scripts/build-electron.mjs --watch\" \"wait-on tcp:3000 && cross-env ELECTRON_RENDERER_URL=http://localhost:3000 electron .\"",
    "build:renderer": "next build",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "vendor": "node scripts/vendor-binaries.mjs",
    "dist": "npm run build && npm run vendor && node scripts/dist.mjs",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm test",
    "verify:app": "node scripts/verify-app.mjs",
    "dist:mac": "npm run build && npm run vendor && node scripts/dist.mjs --mac",
    "dist:win": "npm run build && npm run vendor && node scripts/dist.mjs --win",
    "dist:linux": "npm run build && npm run vendor && node scripts/dist.mjs --linux"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.9.1",
    "@e965/xlsx": "0.20.3",
    "@ffprobe-installer/ffprobe": "2.1.2",
    "@lesjoursfr/html-to-epub": "6.2.0",
    "7zip-bin": "5.2.0",
    "ag-psd": "31.0.2",
    "archiver": "8.0.0",
    "chardet": "2.2.0",
    "docx": "9.7.1",
    "exceljs": "4.4.0",
    "execa": "10.0.1",
    "fast-xml-parser": "5.11.0",
    "ffmpeg-static": "5.3.0",
    "fflate": "0.8.3",
    "file-type": "22.0.2",
    "fonteditor-core": "2.6.3",
    "heic-decode": "2.1.0",
    "html-to-text": "10.0.1",
    "iconv-lite": "0.7.3",
    "jimp": "1.6.1",
    "json5": "2.2.3",
    "linkedom": "0.18.13",
    "mammoth": "1.12.1",
    "marked": "18.0.11",
    "mime-types": "3.0.2",
    "node-7z": "3.0.0",
    "node-unrar-js": "2.0.2",
    "papaparse": "5.7.0",
    "pdfjs-dist": "6.2.108",
    "sharp": "0.35.3",
    "sharp-ico": "0.1.5",
    "smol-toml": "1.8.0",
    "svgo": "4.1.0",
    "tar": "7.5.22",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "word-extractor": "1.0.4",
    "yaml": "2.9.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@playwright/test": "1.62.1",
    "@types/archiver": "8.0.0",
    "@types/mime-types": "3.0.1",
    "@types/node": "26.3.0",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/turndown": "5.0.6",
    "@types/yauzl": "3.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "electron-playwright-helpers": "3.1.2",
    "esbuild": "0.28.2",
    "fast-check": "4.9.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wait-on": "9.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
